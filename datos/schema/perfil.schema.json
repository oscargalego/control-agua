{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perfil.schema.json",
  "title": "Perfil de equipo de ósmosis",
  "type": "object",
  "required": [
    "id",
    "version",
    "brand",
    "model",
    "category",
    "indicator",
    "cartridges",
    "procedures",
    "sources",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "enum": [
        "bajo-fregadero-sin-deposito",
        "clasico-con-deposito",
        "sobremesa"
      ]
    },
    "generic": {
      "type": "boolean"
    },
    "markets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/market"
      }
    },
    "illustration": {
      "type": "string"
    },
    "indicator": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ninguno",
            "luces",
            "pantalla"
          ]
        },
        "countsVolume": {
          "type": "boolean"
        },
        "lightsKey": {
          "type": "string"
        },
        "leds": {
          "type": "array",
          "description": "Luces del equipo en el orden en que se ven: id y etiqueta visible",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "screen": {
          "type": "boolean",
          "description": "Tiene pantalla (TDS o códigos)"
        },
        "intro": {
          "type": "string",
          "description": "i18n: explicación de dónde están las luces"
        },
        "source": {
          "type": "string",
          "description": "i18n: de qué manual sale la tabla"
        }
      }
    },
    "cartridges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref",
          "label",
          "stages",
          "life",
          "fitting"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+$"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "enum": [
                "sedimentos",
                "carbon-granular",
                "carbon-bloque",
                "membrana-ro",
                "postfiltro-carbon",
                "remineralizador",
                "uv"
              ]
            }
          },
          "life": {
            "type": "object",
            "required": [
              "months"
            ],
            "additionalProperties": false,
            "properties": {
              "months": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "liters": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "editable": {
                "type": "boolean"
              },
              "basis": {
                "enum": [
                  "manual",
                  "web-fabricante",
                  "orientativo",
                  "por-verificar"
                ]
              },
              "rangeMonths": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Rango que dan los distintos fabricantes cubiertos por un perfil genérico"
              }
            }
          },
          "fitting": {
            "enum": [
              "bayoneta",
              "vaso-roscado",
              "inline-rapido",
              "giro-sobremesa"
            ]
          },
          "position": {
            "type": "string"
          },
          "compatibleWith": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parts": {
            "$ref": "#/$defs/parts"
          }
        }
      }
    },
    "procedures": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "cartridges",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "cartridges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "manual-oficial",
              "hoja-cartucho",
              "web-fabricante",
              "tienda",
              "practica-habitual"
            ]
          },
          "checked": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "status": {
      "enum": [
        "borrador",
        "verificado"
      ]
    },
    "lights": {
      "type": "array",
      "description": "Significado de las luces o pantallas del equipo",
      "items": {
        "type": "object",
        "required": [
          "group",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "leds",
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "leds": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "off",
                      "blue",
                      "purple",
                      "red",
                      "yellow",
                      "blink",
                      "blinkred",
                      "blinkpurple",
                      "cycle",
                      "cycleyellow"
                    ]
                  }
                },
                "key": {
                  "type": "string",
                  "description": "i18n: <key>.title, <key>.mean, <key>.act"
                },
                "screen": {
                  "type": "string",
                  "description": "Lo que muestra la pantalla en ese estado (TDS, código de error…)"
                },
                "sound": {
                  "enum": [
                    "ninguno",
                    "pitido",
                    "pitidos-2",
                    "pitido-continuo",
                    "pitido-3min",
                    "pitidos-5"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "market": {
      "enum": [
        "es",
        "de",
        "fr",
        "it",
        "uk",
        "us",
        "ca",
        "mx",
        "br"
      ]
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {
          "type": "string",
          "description": "Términos para el enlace de búsqueda de compatibles"
        },
        "notThis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "reason"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "key",
        "scene"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Clave de texto en i18n: <key>.title, <key>.text, <key>.warn, <key>.tip"
        },
        "params": {
          "type": "object"
        },
        "scene": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "minItems": 1
        },
        "timer": {
          "type": "integer",
          "minimum": 1
        },
        "timerKey": {
          "type": "string"
        },
        "critical": {
          "type": "boolean",
          "description": "Paso que no puede saltarse (seguridad, reset, purgado): la app lo resalta"
        },
        "register": {
          "type": "boolean"
        },
        "removes": {
          "type": "boolean",
          "description": "Paso en el que se saca un cartucho: la vista previa gratis termina siempre antes de él"
        }
      }
    }
  }
}